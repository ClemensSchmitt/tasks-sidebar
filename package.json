{
  "name": "tasks-sidebar",
  "displayName": "Tasks Sidebar",
  "description": "Browse, run, and track workspace tasks from a dedicated Visual Studio Code sidebar.",
  "version": "0.1.1",
  "publisher": "ClemboMembo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClemensSchmitt/tasks-sidebar.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:tasksSidebar.view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tasksSidebar",
          "title": "Tasks",
          "icon": "./resources/tasks.svg"
        }
      ]
    },
    "views": {
      "tasksSidebar": [
        {
          "id": "tasksSidebar.view",
          "name": "Task board",
          "type": "webview"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "tasksSidebarGlobal",
        "required": ["label", "fingerprint"],
        "properties": {
          "label": { "type": "string" },
          "fingerprint": { "type": "string" }
        }
      }
    ],
    "commands": [
      {
        "command": "tasksSidebar.refresh",
        "title": "Tasks: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "tasksSidebar.openTasksJson",
        "title": "Tasks: Open tasks.json",
        "icon": "$(edit)"
      },
      {
        "command": "tasksSidebar.openGlobalTasks",
        "title": "Tasks: Open Global Tasks",
        "icon": "$(globe)"
      },
      {
        "command": "tasksSidebar.createTask",
        "title": "Tasks: Create task",
        "icon": "$(add)"
      },
      {
        "command": "tasksSidebar.toggleExternalTasks",
        "title": "Tasks: Toggle external task providers"
      }
    ]
  },
  "configuration": {
    "title": "Tasks Sidebar",
    "properties": {
      "tasksSidebar.includeExternalTasks": {
        "type": "boolean",
        "default": false,
        "description": "Include npm, extension and other external task providers in the sidebar. Workspace and Tasks Sidebar global tasks are always shown."
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test": "npm run compile && node --test test/runtime.test.js test/release.test.js test/actions.test.js",
    "test:extension": "npm run compile && node test/integration/run.js",
    "test:vsix": "node scripts/test-installed-vsix.js",
    "package": "npm run compile && npx --yes @vscode/vsce package",
    "release:version": "node scripts/release.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.4.2"
  },
  "homepage": "https://github.com/ClemensSchmitt/tasks-sidebar#readme",
  "bugs": {
    "url": "https://github.com/ClemensSchmitt/tasks-sidebar/issues"
  },
  "icon": "./resources/marketplace-icon.png",
  "keywords": [
    "tasks",
    "task runner",
    "task management",
    "sidebar"
  ],
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
